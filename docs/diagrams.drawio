ct=0;portConstraint=eastwest;strokeWidth=2;fontSize=15;fontStyle=1;size=50;fillColor=#dae8fc;strokeColor=#1A73A8;" vertex="1" parent="1"><mxGeometry x="915.0" y="70" width="190" height="450" as="geometry"/></mxCell><mxCell id="seq-cancel-page-e6" value="1. Cancel(&quot;R101&quot;)" style="html=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;endFill=1;endSize=10;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="170" as="sourcePoint"/><mxPoint x="430" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-cancel-page-e7" value="2. Find(&quot;R101&quot;)" style="html=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;endFill=1;endSize=10;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="225" as="sourcePoint"/><mxPoint x="720" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-cancel-page-e8" value="3. R101" style="html=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="280" as="sourcePoint"/><mxPoint x="430" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-cancel-page-e9" value="4. Cancel()" style="html=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;endFill=1;endSize=10;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="335" as="sourcePoint"/><mxPoint x="1010" y="335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-cancel-page-e10" value="5. true: now Cancelled" style="html=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="390" as="sourcePoint"/><mxPoint x="430" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="se
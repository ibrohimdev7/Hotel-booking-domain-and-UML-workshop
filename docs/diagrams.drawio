  <diagram name="Context map" id="context-map-page"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="context-map-page-rooms" value="&lt;b&gt;Rooms (Inventory)&lt;/b&gt;&lt;br&gt;Room: number, type, nightly price.&lt;br&gt;In service or out of service.&lt;br&gt;Owns which rooms the hotel sells." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="110" as="geometry"/></mxCell><mxCell id="context-map-page-payments" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;Deposit: amount, Paid or Declined.&lt;br&gt;Owns money only.&lt;br&gt;Never decides if a room is free." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="300" height="110" as="geometry"/></mxCell><mxCell id="context-map-page-reservations" value="&lt;b&gt;Reservations&lt;/b&gt;&lt;br&gt;Guest, stay dates, reservation R101.&lt;br&gt;Status: Confirmed or Cancelled.&lt;br&gt;Owns the booking rule." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="110" as="geometry"/></mxCell><mxCell id="context-map-page-notifications" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;Message, sent by email or SMS.&lt;br&gt;Status: Sent or Failed.&lt;br&gt;Owns delivery of messages." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="300" height="110" as="geometry"/></mxCell><mxCell id="context-map-page-ask-rooms" value="Asks: which rooms exist?" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="context-map-page-reservations" target="context-map-page-rooms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="context-map-page-ask-payments" value="Asks: take a deposit (P17)" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0;entryX=0;entryY=1;" edge="1" parent="1" source="context-map-page-reservations" target="context-map-page-payments"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="context-map-page-announce" value="Announces: ReservationConfirmed" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 4;strokeColor=#2e7d32;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="context-map-page-reservations" target="context-map-page-notifications"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
